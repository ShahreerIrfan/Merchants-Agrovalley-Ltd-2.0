# Merchants AgroValley - Server Environment Configuration
# IMPORTANT: Never commit .env or .env.local to version control!
# In production, inject these secrets through your hosting provider's secret manager.

# Single Admin Account
ADMIN_EMAIL=admin@merchantsagrovalley.com

# Argon2id password hash (Generate using: npm run hash-password)
ADMIN_PASSWORD_HASH=

# Cryptographically random JWT secret (at least 32 characters / 256 bits)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# JWT Issuer and Audience validation
JWT_ISSUER=merchants-agrovalley-auth
JWT_AUDIENCE=merchants-agrovalley-admin

# Canonical application origin for exact Origin header and CSRF validation
APP_ORIGIN=http://localhost:3000

# CSRF Secret (at least 32 characters)
CSRF_SECRET=

# PostgreSQL Database URL
# In Dokploy internal network:
# DATABASE_URL="postgresql://postgres:qZWkj5Rf36cWF0Cnk7Gl@merchants-agrovalley-ltd-merchants-agrovalley-ltd-db-kojraq:5432/postgres"
# External connection:
DATABASE_URL="postgresql://postgres:qZWkj5Rf36cWF0Cnk7Gl@189.72.158.183:5432/postgres"
